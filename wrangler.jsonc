{
  // Static-asset-only Worker: no `main`, no Worker script. Cloudflare serves
  // the files in `directory` directly from the edge.
  //
  // Deployed via Workers Builds connected to the GitHub repo. The Worker name
  // here MUST match the Worker name in the Cloudflare dashboard or the build
  // fails.
  "name": "obiana",
  "compatibility_date": "2026-08-07",

  // Only /api/* reaches this script; everything else is served straight from
  // static assets without invoking a Worker at all.
  "main": "./worker/index.js",

  "assets": {
    // Repo root — this is a plain static site with no build step.
    // See .assetsignore for what is excluded from upload.
    "directory": "./",

    // NOTE: deliberately NOT "single-page-application".
    //
    // The app has no client-side routes (navigation is in-page JS, the URL
    // stays at "/"), so SPA handling would buy nothing — and it would actively
    // hurt: it returns index.html with status 200 for ANY unmatched path,
    // including a missing i18n/locale.<lang>.js. The service worker and the
    // i18n loader both rely on a missing locale failing cleanly so they can
    // fall back to English. Default handling gives a real 404.
    "html_handling": "auto-trailing-slash",

    // Lets the Worker serve assets itself for non-API paths.
    "binding": "ASSETS",

    // Assets normally win over the Worker. The API has no matching file, but
    // being explicit keeps it true even if a path ever collides.
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      // Must be DB — worker/index.js reads env.DB. Wrangler's default
      // suggestion (obiana_suggestions) would leave env.DB undefined and the
      // endpoint would keep reporting not_configured.
      "binding": "DB",
      "database_name": "obiana-suggestions",
      "database_id": "24fabf2e-e7f2-40bb-a9a4-f68b12e9b1b3"
    }
  ]

  // ─── Enabling translation suggestions ───────────────────
  // D1 is bound above. Note the binding MUST stay "DB": an unresolved or
  // misnamed binding does not fail the build, it just silently leaves
  // env.DB undefined, and /api/suggest answers not_configured forever.
  //
  // Secrets, set with `wrangler secret put` (never committed):
  //   HASH_SALT  — salt for the rate-limiting IP hash
  //   NTFY_URL   — optional; a full ntfy topic URL to ping on each submission
}
